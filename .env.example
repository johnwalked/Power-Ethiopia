# CE Power Environment Configuration

# Gemini API Key for Voice Assistant (Realtime Live Audio)
# Set GEMINI_API_KEY (or VITE_GEMINI_API_KEY) in Vercel / local .env.local
GEMINI_API_KEY=your_gemini_api_key_here
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (defaults configured in lib/firebase.ts)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
